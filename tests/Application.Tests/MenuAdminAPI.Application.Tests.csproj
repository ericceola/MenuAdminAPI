<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>MenuAdminAPI.Application.Tests</AssemblyName>
    <RootNamespace>MenuAdminAPI.Application.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Descrição do Projeto -->
  <PropertyGroup>
    <Description>Unit Tests para Application Layer do MenuAdminAPI</Description>
    <Authors>Menu Admin Team</Authors>
    <Company>Menu Admin</Company>
    <Product>MenuAdminAPI</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Diretórios de Saída -->
  <PropertyGroup>
    <OutputPath>..\..\bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>..\..\obj\$(Configuration)\Application.Tests\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- Referências de Projetos -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Domain\MenuAdminAPI.Domain.csproj" />
    <ProjectReference Include="..\..\src\Application\MenuAdminAPI.Application.csproj" />
  </ItemGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <!-- Testing -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.2" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

</Project>
